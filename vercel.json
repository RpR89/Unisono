{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "installCommand": "echo 'nessuna dipendenza da installare'",
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "images": {
    "sizes": [
      384,
      640,
      828,
      1200,
      1920
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "minimumCacheTTL": 2678400,
    "localPatterns": [
      {
        "pathname": "^/assets/.*$",
        "search": ""
      }
    ]
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)content/ordini' ':(exclude)content/utenti.enc.json'"
}
